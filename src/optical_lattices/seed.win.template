! System: 2D optical lattice (generated by optical_lattices)
! -----------------------------------------------------------------------

! --- System Dimensions ---
num_wann  = {num_wannier}
num_bands = {num_wannier}

! --- Grid Configuration ---
mp_grid : {num_q}, {num_q}, 1


search_shells = 100   ! Look past the dense in-plane shells to find the Z-neighbor
kmesh_tol = 0.001     ! Tolerance for k-point mesh generation - Ignore the weight imbalance caused by the vacuum


! --- Unit Cell ---
begin unit_cell_cart
units angstrom
  {a}  0.0  0.0
  0.0  {a}  0.0
  0.0  0.0 11.0     ! Dummy Z-axis (Must be large, e.g., 10x the in-plane size)
end unit_cell_cart

! --- Projections (The "Initial Guess") ---
! These are fractional coordinates relative to the unit cell vectors above.
begin projections
  {initial_guesses}
end projections

! --- K-Points ---
begin kpoints
{kpoints}
end kpoints

! --- Algorithm Parameters ---
num_iter = 300           ! Max iterations
conv_tol = 1.0e-10       ! Stop when spread change is below this
conv_window = 3          ! Number of iterations to satisfy tolerance

! --- Output Control ---
write_xyz = true            ! Writes WF centers to an .xyz file
translate_home_cell = true  ! Shift WFs to be inside the central cell
write_hr = true             ! Writes the Hamiltonian in the WF basis (tight-binding model)
write_u_matrices = true     ! Writes the unitary transformation matrices
